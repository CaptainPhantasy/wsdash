# wsdash LLM Partner configuration — copy to ~/.wsdash/.env.local (global)
# or ./.env.local (per-project override). Real environment variables win.

# --- provider: OpenAI-compatible (OpenAI, local proxies, LM Studio, Ollama, ...) ---
WSDASH_LLM_PROVIDER=openai
WSDASH_LLM_BASE_URL=https://api.openai.com/v1
WSDASH_LLM_API_KEY=sk-...
WSDASH_LLM_MODEL=gpt-4.1

# --- provider: Anthropic ---
#WSDASH_LLM_PROVIDER=anthropic
#WSDASH_LLM_BASE_URL=https://api.anthropic.com
#WSDASH_LLM_API_KEY=sk-ant-...
#WSDASH_LLM_MODEL=claude-sonnet-5

# --- generation ---
WSDASH_LLM_MAX_TOKENS=4096
WSDASH_LLM_TEMPERATURE=0.2

# --- system prompt (internally promptable) ---
# inline addition appended to the default partner prompt:
#WSDASH_LLM_SYSTEM_PROMPT=Prefer bullet answers.
# or full replacement file (default checked: ~/.wsdash/prompts/partner.md):
#WSDASH_LLM_SYSTEM_PROMPT_FILE=/path/to/prompt.md

# --- MCP tool server (Desktop Commander by default) ---
WSDASH_MCP_COMMAND=npx -y @wonderwhy-er/desktop-commander

# --- default gate stage: plan | ask | allow | auto | yolo ---
WSDASH_CHAT_MODE=ask

# --- harness + operator safety overrides ---
# Optional absolute/"~" path to an OMP audit log for recap:
#WSDASH_OMP_AUDIT_LOG=~/.omp/agent/.harness/audit.log
